    "@fortawesome/react-fontawesome": "^0.2.2",
    "@tawk.to/tawk-messenger-react": "^2.0.2",
    "@zxing/library": "^0.21.3",
    "axios": "^1.9.0",
    "bootstrap": "^5.3.6",
    "cordova-plugin-inappbrowser": "^6.0.0",

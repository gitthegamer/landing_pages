{
  "name": "label1landing",
  "private": true,
  "version": "1.0.0",
  "description": "LabelTheme",
  "repository": "",
  "license": "UNLICENSED",
  "scripts": {
    "start": "npm run dev",
    "dev": "cross-env NODE_ENV=development vite",
    "build": "cross-env NODE_ENV=production vite build",
    "build_prerender": "cross-env NODE_ENV=production vite build && node prerender.mjs",
    "build_cap": "npm run build && npx cap sync",
    "update_capgo": "npm run build && npx cap sync && npx @capgo/cli@latest bundle upload --channel production",
    "update_capgo_only": "npx @capgo/cli@latest bundle upload --channel production",
    "postinstall": "cpy --flat ./node_modules/framework7-icons/fonts/*.* ./src/fonts/ && cpy --flat ./node_modules/material-icons/iconfont/*.* ./src/fonts/"
  },
  "browserslist": [
    "IOS >= 15",
    "Safari >= 15",
    "last 5 Chrome versions",
    "last 5 Firefox versions"
  ],
  "dependencies": {
    "@awesome-cordova-plugins/in-app-browser": "^6.16.0",
    "@capacitor-community/app-icon": "^6.0.0",
